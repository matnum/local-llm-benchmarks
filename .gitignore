# model weights — never in git (live in ~/.local/share/models/)
*.gguf
models/

# per-run raw outputs (consolidated.csv + table.md stay tracked)
results/run-*/

# runs kept as evidence but measured with a superseded harness — also excluded
# from consolidate()'s results/run-*/ glob, so they can never enter the rollup
results/superseded-*/

# compiled loglikelihood scorer for the FIN-bench axis (build from tools/score_ll.cpp)
tools/score_ll

# per-run FIN-bench detail (finbench-consolidated.csv + finbench-table.md stay tracked)
results/finbench-*/

# misc
__pycache__/
*.pyc
*.log
# ...except the vendored llama-bench logs behind the published bench columns
# (review: bench/power/memory had no checkable extract); these are tracked.
!results/bench-logs/
!results/bench-logs/**/*.log
.DS_Store
.pytest_cache/
results/embed-*/
